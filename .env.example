PORT=3001
SQLITE_PATH=./data.db
# --- Turso (persistência real — recomendado em produção) ---
# Cria em https://turso.tech → copia URL + token:
#   turso db tokens create <nome-da-db>
TURSO_DATABASE_URL=libsql://kutsakai-tv-mane1334.aws-us-east-2.turso.io
TURSO_AUTH_TOKEN=
# pull da cloud a cada N segundos (10-300). Escritas vão logo ao primário.
TURSO_SYNC_INTERVAL=60
JWT_SECRET=troca-isto-dev
JWT_REFRESH_SECRET=troca-isto-refresh-dev
NEXT_PUBLIC_API_URL=http://localhost:3001/v1
MONITOR_LIMIT=120
# --- monetização (ver PAYMENTS.md) ---
# Preços de teste em MT (admin altera via API sem restart)
PLAN_DAILY_PRICE=15
PLAN_WEEKLY_PRICE=105
PLAN_MONTHLY_PRICE=450
# WhatsApp do admin que recebe os comprovativos (só dígitos, com indicativo: ex. 258841234567)
WHATSAPP_NUMBER=
# Números comerciais que recebem os pagamentos (M-Pesa Vodacom / e-Mola Movitel)
MPESA_MERCHANT_MSISDN=
EMOLA_MERCHANT_MSISDN=
# Automático (futuro): quando existirem, M-Pesa/e-Mola passam a modo auto
# MPESA_API_KEY=
# MPESA_PUBLIC_KEY=
# MPESA_SERVICE_CODE=
# MPESA_BASE_URL=
# MPESA_WEBHOOK_SECRET=
# EMOLA_API_KEY=
# EMOLA_MERCHANT_ID=
# EMOLA_BASE_URL=
# EMOLA_WEBHOOK_SECRET=
