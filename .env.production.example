# Copia para .env em produção local / referência para Render + Cloudflare.
# Nunca commites o .env real (está no .gitignore).

# --- API (Render) ---
PORT=3001
NODE_ENV=production
# VM/Fly com volume: SQLITE_PATH=/data/data.db
# Render Free (efémero): SQLITE_PATH=/tmp/data.db
SQLITE_PATH=/tmp/data.db
JWT_SECRET=gera-um-segredo-longo-aqui-1
JWT_REFRESH_SECRET=gera-um-segredo-longo-aqui-2
# conta que fica admin sozinha ao registar/logar (para /admin/backup)
ADMIN_EMAIL=teu-email@gmail.com
# Frontend(s) permitidos (CORS), separados por vírgula, SEM barra no fim
ALLOWED_ORIGINS=https://tv.kutsakai.dpdns.org,https://kutsakai-tv.pages.dev

# --- persistência (SQLite + snapshots R2 — OBRIGATÓRIO no Render Free) ---
# 1. Cloudflare dashboard → R2 → criar bucket (ex. kutsakai-tv)
# 2. R2 → Manage API tokens → criar token com permissão Object Read & Write SÓ nesse bucket
# 3. Colar aqui. Sem isto, cada restart do Render APAGA users/pagamentos.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=kutsakai-tv
# R2_DB_KEY=db/data.db
# BACKUP_INTERVAL_MIN=15

# --- monetização ---
PLAN_DAILY_PRICE=15
PLAN_WEEKLY_PRICE=105
PLAN_MONTHLY_PRICE=450
WHATSAPP_NUMBER=258841234567
MPESA_MERCHANT_MSISDN=
EMOLA_MERCHANT_MSISDN=

# --- WEB (Cloudflare Pages → Environment Variables no dashboard) ---
# NEXT_PUBLIC_API_URL=https://api.kutsakai.dpdns.org/v1
